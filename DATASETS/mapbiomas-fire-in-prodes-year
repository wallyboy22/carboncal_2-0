// Carrega o asset com as bandas de 1985 a 2023
// var fireCollection = ee.Image('projects/mapbiomas-public/assets/brazil/fire/collection3/mapbiomas_fire_collection3_monthly_burned_v1');
var fireCollection = ee.Image('projects/mapbiomas-workspace/FOGO_COL3/2-Subprodutos/mapbiomas-fire-collection3-monthly-burned-v1');

// Gera a sequência de anos de 1986 a 2023
ee.List.sequence(1986, 2023, 1).evaluate(function(years) {
  
  // Cria uma imagem vazia para armazenar as imagens anuais
  var annualFireImages = ee.Image().select();
  
  // Loop para gerar as imagens anuais de queimadas
  years.forEach(function(year) {
    var bandPreviousYear = 'burned_monthly_' + (year - 1);
    var bandCurrentYear = 'burned_monthly_' + year;
    
    // Seleciona as bandas do ano anterior e do ano atual
    var selectedBands = fireCollection.select([bandPreviousYear, bandCurrentYear]);
    
    // Cria a máscara para os meses de agosto a dezembro do ano anterior
    var maskedPreviousYear = selectedBands.select(bandPreviousYear).gte(8).unmask();
    
    // Cria a máscara para os meses de janeiro a julho do ano atual
    var maskedCurrentYear = selectedBands.select(bandCurrentYear).lte(7).unmask();
    
    // Combina as máscaras e considera uma única ocorrência de fogo
    var mergedImage = maskedPreviousYear.add(maskedCurrentYear);
    
    // Transforma todas as ocorrências de fogo em 1
    var binaryImage = mergedImage.gt(0).selfMask();
    
    // Renomeia a banda para refletir o ano atual
    var renamedImage = binaryImage.rename('burned_year_' + year);
    
    // Adiciona a imagem renomeada à lista de imagens anuais
    annualFireImages = annualFireImages.addBands(renamedImage);
  });
  
  // Exibe a imagem final no console para inspeção
  print('Imagem Final com Múltiplas Bandas:', annualFireImages);
  
  // Define a descrição para a imagem exportada
  var annualBurnedDescription = 'MapBiomas Fire Collection 31 - Imagens anuais de áreas queimadas (1986-2023).';

  // Exporta a imagem anual de queimadas concatenada para um asset
  Export.image.toAsset({
    image: annualFireImages.set('description', annualBurnedDescription),
    description: 'mapbiomas_fire_collection31_annual_burned_areas_v2',
    assetId: 'projects/ee-ipam/assets/CCAL/DATASETS/MAPBIOMAS/mapbiomas_fire_collection31_annual_burned_areas_v2_prodes_year',
    scale: 30,
    region: fireCollection.geometry(),
    maxPixels: 1e13
  });
  
  // Visualiza a banda correspondente ao ano de 2023 no mapa
  Map.addLayer(annualFireImages, 
               {bands:['burned_year_2023'],min: 0, max: 1, palette: ['white', 'red']}, 'Fogo 2023 - AProdes');
  
  // Função para calcular o Tempo Após o Fogo (Time After Fire - TAF)
  var scars = annualFireImages.gte(1).selfMask();
  
  function timeAfterFire(current, previous) {
    var year = ee.Number(current).int();
    var yearPost = year.add(1);
  
    var sliceIndex = ee.List(years).indexOf(current);
    sliceIndex = ee.Number(sliceIndex).add(1);
    var sliceList = ee.List(years).slice(0, sliceIndex, 1);
  
    var alreadyBurned = sliceList.map(function(y) {
      return scars.select([ee.String('burned_year_').cat(ee.Number(y).int())])
        .rename('time_after_fire');
    });
    alreadyBurned = ee.ImageCollection(alreadyBurned).mosaic().byte();
    alreadyBurned = ee.Image(1).updateMask(alreadyBurned).byte();
  
    var burnedThisYear = ee.Image(1).updateMask(scars.select([ee.String('burned_year_').cat(year)]))
      .byte();
  
    var newImage = ee.Image(previous)
      .select(ee.String('time_after_fire_').cat(year))
      .add(alreadyBurned).byte();
  
    newImage = newImage.blend(burnedThisYear);
  
    return ee.Image(previous)
      .addBands(
        newImage.rename(ee.String('time_after_fire_').cat(yearPost))
      );
  }
  
  var first = ee.Image(0).mask(0).rename('time_after_fire_' + ''+years[0]);
  var timeAfterFireImage = ee.List(years).iterate(timeAfterFire, first);
  timeAfterFireImage = ee.Image(timeAfterFireImage).slice(1);

  // Atualiza a imagem para o tempo após o fogo
  timeAfterFireImage = scars.multiply(0).blend(timeAfterFireImage).rename(timeAfterFireImage.bandNames());

  // Define a descrição para a imagem de tempo após o fogo
  var tafDescription = 'MapBiomas Fire Collection 3 - Tempo após o fogo (TAF) acumulado de 1986-2023.';

  // Exporta a imagem de Tempo Após o Fogo (TAF)
  Export.image.toAsset({
    image: timeAfterFireImage.set('description', tafDescription),
    description: 'mapbiomas_fire_collection31_time_after_fire_v2_prodes_year',
    assetId: 'projects/ee-ipam/assets/CCAL/DATASETS/MAPBIOMAS/mapbiomas_fire_collection31_time_after_fire_v2_prodes_year',
    scale: 30,
    region: fireCollection.geometry(),
    maxPixels: 1e13
  });
  
  // Função para calcular a Recorrência de Fogo
  function fireRecurrence(current, previous) {
    var year = ee.String(current);
    var bandname = ee.String('fire_recurrence_').cat(''+years[0]).cat('_').cat(year);
    var fireYear = scars.select(ee.String('burned_year_').cat(year));
    var newImg = ee.Image(previous).slice(-1).unmask().add(fireYear.unmask()).selfMask().rename(bandname);
    
    return ee.Image(previous).addBands(newImg);
  }
  
  var firstRecurrence = scars.slice(0, 1).rename(ee.String('fire_recurrence_').cat(''+years[0]).cat('_').cat(''+years[0]));
  var fireRecurrenceImage = ee.List(years).iterate(fireRecurrence, firstRecurrence);
  fireRecurrenceImage = ee.Image(fireRecurrenceImage);

  // Define a descrição para a imagem de recorrência de fogo
  var recurrenceDescription = 'MapBiomas Fire Collection 3 - Recorrência de fogo de 1986 a 2023.';

  // Exporta a imagem de Recorrência de Fogo
  Export.image.toAsset({
    image: fireRecurrenceImage.set('description', recurrenceDescription),
    description: 'mapbiomas_fire_collection3_fire_recurrence_v2_prodes_year',
    assetId: 'projects/ee-ipam/assets/CCAL/DATASETS/MAPBIOMAS/mapbiomas_fire_collection3_fire_recurrence_v2_prodes_year',
    scale: 30,
    region: fireCollection.geometry(),
    maxPixels: 1e13
  });
  
  // Visualization
  var palette = [
    "FFFFFF", "800000", "850708", "8B0E0F", "901417", "961B1E",
    "9B2226", "9F2222", "A3211E", "A6211A", "AA2016", "AE2012",
    "B42E0F", "B93C0C", "BF4B08", "C45905", "CA6702", "BF7C27",
    "B4924D", "AAA772", "9FBD98", "94D2BD", "78C5B5", "5DB9AD",
    "41ACA6", "26A09E", "0A9396", "0876AB", "0658C0", "043BD5",
    "021DEA", "0000FF", "0000E6", "0000CC", "0000B3", "000080"
  ];
  
  
  var visParams_taf = {
    bands:['time_after_fire_2023'],
    min: 0,
    max: 39,
    palette: palette
  };

  
  // Visualiza a banda correspondente ao tempo após o fogo e recorrência de fogo no mapa
  Map.addLayer(timeAfterFireImage, 
               visParams_taf, 'Tempo Após Fogo 2023');
  
  Map.addLayer(fireRecurrenceImage,{bands:['fire_recurrence_1986_2023'],min: 1, max: 39, palette: require('users/geomapeamentoipam/MapBiomas__Fogo:00_Tools/Palettes.js').get('frequencia')}, 'Recorrência de Fogo 2023');
});
