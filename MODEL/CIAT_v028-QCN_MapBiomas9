// 🔹 Função para calcular mudanças temporais
function processBands(bandnames) {
  var container = ee.Image().select();

  bandnames.slice(1, -1).forEach(function(bandname) {
    var index = bandnames.indexOf(bandname);
    var prev_bands = bandnames.slice(0, index);
    var post_bands = bandnames.slice(index + 1);

    var sec_veg = deforestationSecondaryVeg.select(bandname);
    var sec_veg_7 = sec_veg.eq(7);
    var img_bandname = simple_lulc.select(bandname);

    var img_prev_bands = simple_lulc.select(prev_bands).updateMask(sec_veg_7.neq(0)).reduce('first');
    var img_post_bands = simple_lulc.select(post_bands).updateMask(sec_veg_7.neq(0)).reduce('first');

    var sum = img_prev_bands.unmask().multiply(10).add(img_post_bands.unmask()).selfMask();

    // 🔹 Mapeamento de pixels (remapeando valores)
    var remap_0 = [0, 1, 2, 10, 11, 12, 20, 21, 22];
    var remap_1 = [0, 1, 2, 1, 1, 3, 2, 1, 2];
    var remap = sum.remap(remap_0, remap_1);

    var final_image = sec_veg.where(sec_veg.eq(7), remap);
    container = container.addBands(final_image);
  });

  return container;
}


