var biomas = ee.FeatureCollection('projects/mapbiomas-workspace/AUXILIAR/biomas_IBGE_250mil');

years.forEach(function(year){
  var img_year = observed.select('classification_'+year);
  
  var table = area_ha
    .addBands(img_year)
    .reduceRegions({
      collection:biomas,
      reducer:ee.Reducer.sum().group(1,'classe'),
      scale:1000,
    }).map(function(feature){
      
      feature = ee.Feature(feature);
      var subtable = ee.List(feature.get('groups'))
        .map(function(obj){
          return ee.Feature(null)
            .set(obj)
            .select(['classe','sum'],['int classe','Área ha']);
        })
        .map(function(feat){
          
          feat = ee.Feature(feat);
          var int_classe = feat.getNumber('int classe');
          var int_qcn = int_classe.divide(100).int();
          var int_mb = int_classe.mod(100).int();
          var int_convergence = int_qcn.eq(int_mb); 
          
          return feat.set({
            'int QCN':int_qcn,
            'int MB':int_mb,
            'Classe QCN':ee.Dictionary(legend).get(int_qcn),
            'Classe MB':ee.Dictionary(legend).get(int_mb),
            'int Convergência':int_convergence,
            'Convergência':ee.Dictionary(legend_convergence).get(int_convergence),
            'Ano':year,
            'Bioma':feature.get('Bioma')
          });
        });
      
      return ee.FeatureCollection(subtable);
    });
    
    table = table.flatten();
    // print('table',table.limit(10));
    
    var description = 'v5-simple_comparation_qcn_mb-'+year;
    var selectors = [
      'Classe MB',
      'Classe QCN',
      'Convergência',
      'int Convergência',
      'int MB',
      'int QCN',
      'int classe',
      'Área ha',
      'Ano',
      'Bioma'
    ];
    
    Export.table.toDrive({
      collection:table,
      description:description,
      folder:'SIMPLE COMPARATION QCN MB',
      fileNamePrefix:description,
      fileFormat:'CSV',
      selectors:selectors,
      // maxVertices:,
      // priority:
    });

});


