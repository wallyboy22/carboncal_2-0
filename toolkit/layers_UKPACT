function ages_products (coverage_img,values){
  // Máscara multibanda 0/1
  var class_mask_timeseries = coverage_img.multiply(0);
  values.forEach(function(a){ class_mask_timeseries = class_mask_timeseries.where(coverage_img.eq(a), 1); });
  class_mask_timeseries = class_mask_timeseries.unmask(0).byte();
  var bandList = coverage_img.bandNames();

  // Construtor de streak
  function streak(countWhen, mode, gateOut) {
    var seed = ee.Image(0).rename(ee.String('classification').cat('_1984')).toByte();
    return ee.Image(bandList.iterate(function(current, previous) {
      var b = ee.String(current);
      var y = ee.Number.parse(b.slice(-4)).int();
      var yPrev = y.subtract(1);
      var idx = bandList.indexOf(b);

      var inClass  = class_mask_timeseries.select(b);
      var flag     = ee.Image(ee.Algorithms.If(ee.String(countWhen).compareTo('in').eq(0), inClass, inClass.not()));

      if (gateOut) {
        var everSeenBefore = ee.Image(ee.Algorithms.If(
          idx.gt(0), class_mask_timeseries.slice(0, idx).reduce('max'), ee.Image(0)
        )).unmask(0);
        flag = flag.multiply(everSeenBefore);
      }

      var prev = ee.Image(previous).select(ee.String('classification').cat('_').cat(yPrev)).unmask(0);
      var out  = ee.Image(ee.Algorithms.If(
        ee.String(mode).compareTo('carry').eq(0),
        prev.add(flag),
        prev.add(1).multiply(flag)
      )).toByte();

      return ee.Image(previous).addBands(out.rename(ee.String('classification').cat('_').cat(y)));
    }, seed)).slice(1);
  }

  // Quatro saídas principais


  return {
    eqCarry:streak('in',  'carry', false),
    eqZero:streak('in',  'zero',  false),
    neqCarry:streak('out', 'carry', true),
    neqZero:streak('out', 'zero',  true),
  };
}

