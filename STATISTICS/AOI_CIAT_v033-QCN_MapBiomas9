var ufClasses = ee.Dictionary({
  0: 'Não observado',
  11: 'RO',
  12: 'AC',
  13: 'AM',
  14: 'RR',
  15: 'PA',
  16: 'AP',
  17: 'TO',
  21: 'MA',
  22: 'PI',
  23: 'CE',
  24: 'RN',
  25: 'PB',
  26: 'PE',
  27: 'AL',
  28: 'SE',
  29: 'BA',
  31: 'MG',
  32: 'ES',
  33: 'RJ',
  35: 'SP',
  41: 'PR',
  42: 'SC',
  43: 'RS',
  50: 'MS',
  51: 'MT',
  52: 'GO',
  53: 'DF'
});

var aoi_ciat_classes = ee.Dictionary({
  1: '100+ Labs',
  2: 'Lab de Impacto',
  3: 'Nossa Floresta, Nossa Casa',
  4: 'PTMJ',
  5: 'Pesca para Sempre',
  6: 'Revitalização da Cadeia da Borracha',
  7: 'Sociobioeconomia na Amazônia',
  8: 'Desenvolvimento Territorial no Sudeste Paraense',
  9: 'INGÁ',
  10: 'Carbono Insetting',
  11: 'Emprestimo Coletivo',
  12: 'IBS',
  13: 'Incubadora da Floresta',
  14: 'Semeando a Sustentabilidade',
});

var legends = require('users/geomapeamentoipam/MapBiomas__Fogo:00_Tools/Legends.js');

var  niveis = ee.Dictionary(legends.get('lulc_mbc09_niveis')),
     nivel_0 = ee.Dictionary(legends.get('lulc_mbc09_nivel_0')),
     nivel_1 = ee.Dictionary(legends.get('lulc_mbc09_nivel_1')),
     nivel_1_1 = ee.Dictionary(legends.get('lulc_mbc09_nivel_1_1')),
     nivel_2 = ee.Dictionary(legends.get('lulc_mbc09_nivel_2')),
     nivel_3 = ee.Dictionary(legends.get('lulc_mbc09_nivel_3')),
     nivel_4 = ee.Dictionary(legends.get('lulc_mbc09_nivel_4'));


// Cálculo das estatísticas de área

[
  'biomass_stock',
  'co2e_deforestation',
  'co2e_fire',
  'co2e_liquid',
  'co2e_logging',
  'co2e_removal',
  'carbon_stock'
].forEach(function(band){
  
  pixelTonelada.select(band+'.*').bandNames().evaluate(function(bandnames){
    print('bandnames',bandnames);
    
    var bandnames_simples = ee.List(bandnames.map(function(bandname){return ee.String(bandname).slice(0,-5)})).distinct();
    print('bandnames_simples',bandnames_simples);
  
    var tables = bandnames
      .slice(-1) // Utilizando apenas o último ano (2023)
      .map(function(bandname){
  
        var year = bandname.slice(-4);
        var year_lulc;
        if (parseInt(year) >= 2023){
          year_lulc = 2023;
        } else {
          year_lulc = year;
        }
        
        var metric_name = bandname.slice(0,-5);
  
        // --- --- ---
        var observed_area = pixelAreaHa
          .addBands(landCover_original.select('classification_' + year_lulc))
          .addBands(territory_img);
          
        var reduce_area = observed_area.reduceRegion({
          reducer: ee.Reducer.sum().group(1, 'territory').group(1, 'classe'),
          geometry: bounds,
          scale: scale,
          maxPixels: 1e13,
        }).get("groups");
        
        var table_area = ee.List(reduce_area)
          .map(function(obj_n1){
            obj_n1 = ee.Dictionary(obj_n1);
            var classe_int = obj_n1.getNumber('classe').int();
            
            return ee.FeatureCollection(ee.List(obj_n1.get('groups'))
              .map(function(obj_n2){
                obj_n2 = ee.Dictionary(obj_n2);
                
                var territory_int = obj_n2.getNumber('territory').int();

                var ciat_id = territory_int.mod(100).int();
                
                territory_int = territory_int.divide(100).int();
                
                var bioma_id = territory_int.mod(10).int();
                
                var uf_id = territory_int.divide(10).int();
                
                
                var area_ha = obj_n2.getNumber('sum');
                
                return ee.Feature(null)
                  .set({
                    'index': ee.String(classe_int).cat('-').cat(territory_int).cat('-').cat(year),
                    'Área ha': area_ha,
                    'Ano': year,
                    'Cobertura n0': nivel_0.get(classe_int),
                    'Cobertura n1': nivel_1.get(classe_int),
                    'Cobertura n1_1': nivel_1_1.get(classe_int),
                    'Cobertura n2': nivel_2.get(classe_int),
                    'Cobertura n3': nivel_3.get(classe_int),
                    'Cobertura n4': nivel_4.get(classe_int),
                    'Bioma': biomasClasses.get(bioma_id),
                    'Unidade Federativa': unidadeFederativaClasses.get(uf_id),
                    'UF': ufClasses.get(uf_id),
                    'Project':aoi_ciat_classes.get(ciat_id),
                    'Project_id':ciat_id
                    // 'classe_int': classe_int,
                    // 'territory_int': territory_int,
                  });
              }));
            
          });
        
        table_area = ee.FeatureCollection(table_area).flatten();
        
        // --- --- ---
        var observed_toneladas = pixelTonelada.select(bandname)
          .addBands(landCover_original.select('classification_' + year_lulc))
          .addBands(territory_img);
          
  
        var reduce_toneladas = observed_toneladas
          .reduceRegion({
            reducer: ee.Reducer.sum().group(1, 'territory').group(1, 'classe'),
            geometry: bounds,
            scale: scale,
            maxPixels: 1e13,
          }).get("groups");
        
        var table_toneladas = ee.List(reduce_toneladas)
          .map(function(obj_n1){
            obj_n1 = ee.Dictionary(obj_n1);
            var classe_int = obj_n1.getNumber('classe').int();
            
            return ee.FeatureCollection(ee.List(obj_n1.get('groups'))
              .map(function(obj_n2){
                obj_n2 = ee.Dictionary(obj_n2);
                
                var territory_int = obj_n2.getNumber('territory').int();
                
                var toneladas = obj_n2.getNumber('sum');
                
                return ee.Feature(null)
                  .set({
                    'metric_name':metric_name,
                    'index': ee.String(classe_int).cat('-').cat(territory_int).cat('-').cat(year),
                  }).set('tons_'+metric_name,toneladas);
              }));
            
          });
        
        table_toneladas = ee.FeatureCollection(table_toneladas).flatten();
        
        // --- --- ---
        // Junção das tabelas de quantificação do total de área em hectares e carbono organico do solo em toneladas
        var  joinKey = 'index';
        var join = ee.Join.inner();
        var filter_join = ee.Filter.equals({
          'leftField':joinKey,
          'rightField':joinKey,
        });
        
        var table = join.apply(table_area, table_toneladas, filter_join)
        // Função para copiar as propriedades de dois Features juntos
        .map(function getJoin (feature) {
          return  ee.Feature(null)
            .copyProperties(feature.get('primary'))
            .copyProperties(feature.get('secondary'));
        });
        
        // Verificar o resultado
        // print('Joined Features:', joinedFeatures);
        // print('toneladas:', toneladas);
        // print('areas:', areas);
        
        return ee.FeatureCollection(table);
      });
    
    tables = ee.FeatureCollection(tables).flatten();
  
    print('tables', tables.limit(100),tables.aggregate_array('metric_name').distinct());
    
    // Exportar para o Drive
    Export.table.toDrive({
      collection: tables,
      description: description + '_' + band + '_'  + version,
      fileFormat: 'CSV',
      folder: folder,
       selectors:[
        // 'index',
        'Ano',
        'Cobertura n0',
        'Cobertura n1_1',
        'Cobertura n2',
        'Cobertura n3',
        'Cobertura n4',
        // 'Project_id',
        'Project',
        'Bioma',
        'UF',
        'Unidade Federativa',
        'Área ha',
        'metric_name',
        'tons_' + band,
        // 'tons_co2e_liquid',
        // 'tons_co2e_fire',
        // 'tons_co2e_logging',
        // 'tons_co2e_removal',
        // 'tons_co2e_emission',
        // 'tons_biomass_stock',
        // classe_int	territory_int	
        ]
    });
    
  });
});