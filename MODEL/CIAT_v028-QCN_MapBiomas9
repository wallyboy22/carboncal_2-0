var agb_selective_logging = past_carbon.select('AGB');
var selective_logging_balance = ee.Image().select();

[2017,2018,2019,2020,2021,2022,2023].forEach(function(year){
  /////// Selective Logging emissions ///////
  var sl_year_dis = ee.Image('projects/ee-ipam/assets/CCAL/DATASETS/PRODES/PRODES_ANO_CIVIL/DeterAnoProdes_' + year + '_cs_disordered').unmask();
  var sl_year_geo = ee.Image('projects/ee-ipam/assets/CCAL/DATASETS/PRODES/PRODES_ANO_CIVIL/DeterAnoProdes_' + year + '_cs_geometric').unmask();

  var sl_year = ee.Image(0)
        .multiply(sl_year_dis)
        .multiply(sl_year_geo)
        .multiply(stable_florest)
        .multiply(amazonia_img);

  var sl_Cbalance_year = agb_selective_logging.multiply(sl_year).multiply(0.196) // Loss factor from Lapola et al. (2023) | 19.6% of C loss year-1
    .rename('selective_logging_balance_'+year)
    .float();
    
  

  // Updating carbon stock (Selective Logging)
  agb_selective_logging = agb_selective_logging.subtract(sl_Cbalance_year.unmask());
  
  selective_logging_balance = selective_logging_balance.addBands(sl_Cbalance_year);
});


