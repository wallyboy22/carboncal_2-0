function calculateCO2Emissions(Year) {
  
  var aoi = ee.FeatureCollection('projects/ee-ipam/assets/BR_UF_Biomas')
              .filter(ee.Filter.eq('Bioma', 'Cerrado')); 
  
  ///// Deforestation emissions ///////
  var deforestation_year = prodes_def.eq(Year);
  
  var def_co2 = total.multiply(deforestation_year);
  var def_ch4 = agb_dw_l.multiply(deforestation_year).multiply(1/0.47).multiply(0.379).multiply(6.8).multiply(0.001);
  var def_n2o = agb_dw_l.multiply(deforestation_year).multiply(1/0.47).multiply(0.379).multiply(0.2).multiply(0.001);

  // Soma das Emissões de Desmatamento
  var emission_def = def_co2.add(def_ch4).add(def_n2o).rename('emission_def_' + Year);
  emission_def = emission_def.subtract(emission_def.multiply(0.088));
  
  // Atualização do Estoque de Carbono após Desmatamento
  agb_dw_l = agb_dw_l.multiply(deforestation_year.neq(1));
  agb = agb.multiply(deforestation_year.neq(1));
  bgb = bgb.multiply(deforestation_year.neq(1));
  total = agb_dw_l.add(bgb);

  ///// Exportação das Emissões como Rasters ///////
  var prefix = 'cerrado';
  var folder = 'CCAL/FREL_BR_2017_2023';
  
  // Função Auxiliar para Exportar Imagens
  function exportImage(image, description) {
    Export.image.toAsset({
      image: image,
      description: description,
      assetId: 'projects/ee-ipam/assets/' + folder + '/' + description,
      region: cerrado.geometry().bounds(),
      scale: 30,
      maxPixels: 1e13
    });
  }
  
  // Exportar Emissões de Desmatamento
  var emission_def_sum = emission_def.rename(prefix + '_emission_def_' + Year);
  exportImage(emission_def_sum, prefix + '_emission_def_' + Year);
  
  // Estoque Total Inicial (AGB+BGB+DW+L)
Export.image.toAsset({
  image: total,
  description: 'cerrado_stock_stock_' + Year,
  assetId: 'projects/ee-ipam/assets/CCAL/FREL_BR_2017_2023/cerrado_stock_stock_' + Year,
  region: cerrado.geometry().bounds(),  // converte a coleção de áreas para uma geometria (união)
  scale: 30,
  crs: 'EPSG:4326',
  maxPixels: 1e13
});
  
  return Year + 1; // Retorna o próximo ano
}

// Função para Iterar Através dos Anos
function iterateYears(startYear, endYear) {
  if (startYear < endYear) {
    var nextYear = calculateCO2Emissions(startYear); 
    iterateYears(nextYear, endYear);
  }
}

// Chamando a Função para Calcular as Emissões de CO2 no período de 2017 a 2023
