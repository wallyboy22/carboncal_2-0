// 2. Função para Gerar uma Barra de Cores (Color Bar) Dinâmica para Legendas
// ------------------------------------------------

/**
 * Função que gera uma barra de cores (color bar) para servir de legenda visual para os mapas.
 * A função recebe os parâmetros de visualização e um título, retornando um painel contendo:
 *   - O título da legenda.
 *   - A miniatura representativa da paleta de cores.
 *   - Rótulos para os valores mínimo, médio e máximo.
 * 
 * @param {Object} visParams - Parâmetros de visualização contendo, pelo menos, a paleta e os valores mínimo e máximo.
 * @param {String} title - Título para a barra de cores.
 * @returns {ui.Panel} - Painel contendo a barra de cores e os rótulos.
 */
function getColorBar(visParams, title) {
  // Define estilos para os componentes da barra de cores
  var sty = {
    thumb: {
      margin: '2px',
      backgroundColor: '00000000',
      stretch: 'horizontal',
      height: '10px'
    },
    label: {
      margin: '0px',
      fontSize: '14px',
      backgroundColor: '00000000',
      stretch: 'horizontal',
      textAlign: 'center'
    },
    label2: {
      textAlign: 'center',
      margin: '0px',
      fontSize: '14px',
      backgroundColor: '00000000',
      stretch: 'both'
    },
    label3: {
      textAlign: 'right',
      margin: '0px',
      fontSize: '10px',
      backgroundColor: '00000000',
      stretch: 'horizontal'
    },
    title: {
      margin: '0px',
      fontSize: '12px',
      fontWeight: 'bold'
    }
  };

  // Função interna que gera a miniatura da barra de cores com base em uma paleta fornecida.
  function returnColorBar(palette) {
    var params = {
      bbox: [0, 0, 1, 0.1],
      dimensions: '100x10',
      format: 'png',
      min: 0,
      max: 1,
      position: 'bottom-left',
      palette: palette
    };

    // Cria a miniatura usando a imagem de referência de latitude
    var thb = ui.Thumbnail({
      image: ee.Image.pixelLonLat().select(0),
      params: params,
      style: sty.thumb
    });
    
    return thb;
  }
  
  // Cria a miniatura da barra de cores usando a paleta definida em visParams
  var colorBar = returnColorBar(visParams.palette);
  
  // Cria os rótulos para o título e para os valores mínimo, médio e máximo
  var label_title = ui.Label({ value: title, style: sty.title });
  var label_init = ui.Label({ value: visParams.min, style: sty.label });
  var label_mean = ui.Label({ value: ((visParams.min + visParams.max) / 2), style: sty.label2 });
  var label_end = ui.Label({ value: visParams.max, style: sty.label });
  
  // Agrupa os rótulos dos valores em um painel horizontal
  var legendLabels = ui.Panel({
    widgets: [
      label_init,
      label_mean,
      label_end
    ],
    style: { margin: '0px' },
    layout: ui.Panel.Layout.Flow('horizontal')
  });
  
  // Concatena o título, a miniatura e os rótulos em um painel vertical
  var panel_legend = ui.Panel({
    widgets: [
      label_title,
      colorBar,
      legendLabels
    ],
    layout: ui.Panel.Layout.flow('vertical'),
    style: {
      backgroundColor: 'ffffff80',
      stretch: 'horizontal',
      minWidth: '200px'
    }
  });
  
  // Cria o painel final que envolve o painel da legenda
  var panel_body = ui.Panel({
    widgets: [panel_legend],
    layout: ui.Panel.Layout.flow('horizontal'),
    style: {
      margin: '0px',
      backgroundColor: 'ffffff80',
      stretch: 'horizontal'
    }
  });
  
  return panel_body;
}

