        // Converte bandas anuais (regex) em IC 1-banda 'value' com 'system:time_start'
        function toYearlyIC(img, regexOrPrefix) {
          var bands = img.select(regexOrPrefix).bandNames();
          return ee.ImageCollection(bands.map(function (b) {
            b = ee.String(b);
            var y = b.slice(-4);
            return img.select([b])
              .rename('value')
              .set('Ano', y)
              .set('system:time_start', ee.Date.parse('YYYY', y).millis());
          }));
        }

        // Plota a série (um gráfico por ponto)
        function plotPixelTrajectory(icYearly, pointsList, tituloBase, scale) {
          pointsList.forEach(function (item) {
            var geom = item[0];
            var nome = item[1];

            var chart = ui.Chart.image.series({
              imageCollection: icYearly,
              region: geom,
              reducer: ee.Reducer.first(),
              scale: scale,
              xProperty: 'system:time_start'
            })
              .setChartType('LineChart')
              .setOptions({
                title: tituloBase + ' — ' + nome,
                hAxis: { title: 'Ano' },
                vAxis: { title: 'Valor no pixel' },
                pointSize: 4,
                legend: { position: 'none' }
              });

            ui_panel.add(ui.Label('Ponto: ' + nome));
            ui_panel.add(chart);
          });
        }

