// Inicializa a imagem que acumulará os balanços anuais da extração seletiva, essas bandas são descartadas na imagem final de corte seletivo
var selectiveLoggingEmiss = fireEmiss_co2e.slice(0,31).unmask().multiply(0);

// Para cada ano de interesse, processa os dados de desmatamento seletivo
[2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024].forEach(function (year) {
  // Carrega duas imagens para cada ano: uma com dados desordenados e outra com dados geométricos
  // var slYearDis = ee.Image('projects/ee-ipam/assets/CCAL/DATASETS/PRODES/PRODES_ANO_CIVIL/DeterAnoProdes_' + year + '_cs_disordered').unmask();
  // var slYearGeo = ee.Image('projects/ee-ipam/assets/CCAL/DATASETS/PRODES/PRODES_ANO_CIVIL/DeterAnoProdes_' + year + '_cs_geometric').unmask();
  var slYearDis = ee.Image("projects/ee-ipam/assets/MRV_REDD_PARA/0_Activity_Year/degradation_" + year + '_sl_disordered').unmask();
  var slYearGeo = ee.Image("projects/ee-ipam/assets/MRV_REDD_PARA/0_Activity_Year/degradation_" + year + '_sl_geometric').unmask();

  var stableForest = ee.Image('projects/ee-ipam/assets/SEEG/SEEG13/13_3_Stable_cover/SEEG_c13_2024')
    .unmask().eq(3);

  var amazonBiome = biomes.filter(ee.Filter.equals('Bioma', 'Amazônia'));
  var amazonMask = ee.Image().paint(amazonBiome).eq(0);

  // Combina as duas fontes para identificar áreas de extração seletiva
  var slYear = ee.Image(0)
    .where(slYearDis.eq(1), 1)
    .where(slYearGeo.eq(1), 1)
    // Aplica máscara para manter somente áreas de floresta estável dentro do limite da Amazônia
    .multiply(stableForest)
    .multiply(amazonMask)
    .selfMask();

  // Calcula o balanço de carbono da extração seletiva para o ano corrente,
  // considerando uma fração (0.196) aplicada ao AGB
  var slCarbonBalanceYear = agbSelectiveLogging.multiply(slYear).multiply(0.196)
    .rename('selective_logging_balance_' + year)
    .float();

  // Atualiza o estoque de AGB subtraindo o balanço do ano corrente
  // e converte a diferença para CO₂ (multiplicador 3.67)
  agbSelectiveLogging = agbSelectiveLogging.subtract(slCarbonBalanceYear.unmask());
  
  
// 1840.75 / 3.64 = 505
  // Acumula o balanço da extração seletiva ao longo dos anos
  selectiveLoggingEmiss = selectiveLoggingEmiss.addBands(slCarbonBalanceYear.multiply(3.67));
});

