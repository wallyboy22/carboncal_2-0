    return feat.set({
      year:ee.Date(feat.getNumber('VIEW_DATE')).format('Y'),
    });
  });

var annual_selective_looging = ee.Image().paint(corte_seletivo.filter(ee.Filter.equals('year',''+2017))).eq(0).int16().rename('classification_2017');
var frequency_selective_looging = annual_selective_looging;
var last_year_selective_looging = annual_selective_looging.multiply(2017);

[2018,2019,2020,2021,2022,2023,2024,2025]
  .forEach(function(year){
    var annual = ee.Image().paint(corte_seletivo.filter(ee.Filter.equals('year',''+year))).eq(0);
    
    annual_selective_looging = annual_selective_looging.addBands(annual.rename('classification_'+year).int16());
    frequency_selective_looging = frequency_selective_looging.addBands(annual_selective_looging.reduce('sum').rename('classification_'+year).int16());
