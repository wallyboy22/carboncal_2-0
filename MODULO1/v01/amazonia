// Selective Logging t0 (2017)
var sl_year = ee.Image("projects/ee-ipam/assets/CCAL/DATASETS/PRODES/PRODES_ANO_CIVIL/DeterAnoProdes_2017_cs_disordered")
              .multiply(brazil_forests)
