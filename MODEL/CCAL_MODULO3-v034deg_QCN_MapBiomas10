/**
 * Função que percorre as bandas temporais e, para pixels com transição identificada como "7",
 * realiza a remapeamento considerando os estados anteriores e posteriores.
 * 
 * @returns {ee.Image} Imagem com as transições corrigidas.
 */
// 🔹 Função para calcular mudanças temporais
function processBands(bandnames) {
  var container = ee.Image().select();

  // Cria uma máscara para processar apenas os pixels que não têm o valor 7.
  var simple_lulc_extended = simple_lulc.updateMask(deforestationSecondaryVeg.neq(7));

  // Estende a série temporal para garantir que a busca por anos vizinhos funcione nos extremos.
  simple_lulc_extended = simple_lulc_extended
    .select('classification_1985').rename('classification_1984')
    .addBands(simple_lulc_extended)
    .addBands(simple_lulc.select('classification_2024').rename('classification_2025'));

  var bandnames_extend = ['classification_1984'].concat(bandnames).concat(['classification_2025']);

  // Itera sobre cada ano para aplicar a correção.
  bandnames.forEach(function(bandname) {
    var index = bandnames_extend.indexOf(bandname);
    var prev_bands = bandnames_extend.slice(0, index);
    var post_bands = bandnames_extend.slice(index + 1);

    var img_prev_bands = simple_lulc_extended.select(prev_bands).reduce('lastNonNull');
    var img_post_bands = simple_lulc_extended.select(post_bands).reduce('firstNonNull');

    var sum = img_prev_bands.unmask().multiply(10).add(img_post_bands.unmask()).selfMask();
    
    var remap_0 = [0, 1, 2, 10, 11, 12, 20, 21, 22];
    var remap_1 = [0, 1, 2, 1, 1, 3, 2, 1, 2];
    var remap = sum.remap(remap_0, remap_1);

    var sec_veg_year = deforestationSecondaryVeg.select(bandname);
    var final_image = sec_veg_year.where(sec_veg_year.eq(7), remap);

    container = container.addBands(final_image);
  });

  return container.byte();
}

