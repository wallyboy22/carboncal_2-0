function getColorBar (visParams,title){
  var sty = {
    thumb:{
      margin:'2px',
      backgroundColor:'00000000',
      stretch: 'horizontal',
      height:'10px'
    },
    label:{
      margin:'0px 0px 0px 0px',
      fontSize:'14px',
      backgroundColor:'00000000',
      stretch: 'horizontal',
      textAlign:'center',
    },
    label2:{
      textAlign:'center',
      margin:'0px 0px 0px 0px',
      fontSize:'14px',
      backgroundColor:'00000000',
      stretch: 'both'
    },
    label3:{
      textAlign:'right',
      margin:'0px 0px 0px 0px',
      fontSize:'10px',
      backgroundColor:'00000000',
      stretch: 'horizontal'
    },
    title:{
      margin:'0px 0px 0px 0px',
      fontSize:'12px',
      fontWeight:'bold'
    },
  };

  var boolean_thumb_palette = true;
 
  function returnColorBar(palette){
      var params = {
        bbox: [0, 0, 1, 0.1],
        dimensions: '100x10',
        format: 'png',
        min: 0,
        max: 1,
        position: 'bottom-left',
        palette: palette
      };
    
      var thb = ui.Thumbnail({
        image: ee.Image.pixelLonLat().select(0),
        params: params, 
        style:sty.thumb
      });
      
      return thb;
  
    }
    
  var params = {
      bbox: [0, 0, 1, 0.1],
      dimensions: '100x10',
      format: 'png',
      min: 0,
      max: 1,
      position: 'bottom-left',
      palette: visParams.palette
    };
  
  var colorBar = returnColorBar(visParams.palette);
  
  var label_title = ui.Label({value:title,style:sty.title});
  var label_init = ui.Label({value:visParams.min,style:sty.label});
  var label_mean = ui.Label(((visParams.min+visParams.max)/2),sty.label2);
  var label_end = ui.Label({value:visParams.max,style:sty.label});
  
  var legendLabels = ui.Panel({
        widgets: [
          label_init,
          label_mean,
          label_end
        ],
        style:{margin:'0px'},
        layout: ui.Panel.Layout.Flow('horizontal')});

  var widgets = [
    label_title,
    colorBar,
    legendLabels
  ];
    
  var panel_legend = ui.Panel({
    widgets:widgets,
    layout:ui.Panel.Layout.flow('vertical'), 
    style:{
      backgroundColor:'ffffff80',
      stretch: 'horizontal',
      minWidth:'200px'
    }
  });
  
  var panel_body = ui.Panel({
    widgets:[panel_legend],
    layout:ui.Panel.Layout.flow('horizontal'), 
    style:{
      margin:'0px',
      backgroundColor:'ffffff80',
      stretch: 'horizontal',
    }
  });
  
  return panel_body;
}
