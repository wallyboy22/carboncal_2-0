function createThumbnail(image, region, title, position,lateral, vertical) {
  var title_point = text.getLocation(region, position, lateral, vertical);
  var txt_scale = 10000; // tambem alterar o tamanho da letra
  var txt_params = {
    fontSize:24, // tambem alterar o tamanho da letra
    textColor: '000000',
    outlineColor: 'fefefe', 
    outlineWidth: 2, 
    outlineOpacity: 0.6
  };
  var thumbnailParams = {
    dimensions: 800,
    region: region,
    format: 'png',
  };

  var thumbnail = ui.Thumbnail({
    image: image.blend(text.draw(title, title_point, txt_scale, txt_params)),
    params: thumbnailParams,
    style: {
      position: 'bottom-left',
      width: '300px'
    }
  });

  print(title, thumbnail);
}
