var dictionary = {};
legend.forEach(function(list){
  dictionary[list[0]] = list[3];
});


var qcn_path = 'projects/mapbiomas-workspace/CCAL/DATASETS/QCN';

var qcn_assets = ee.data.listAssets(qcn_path).assets
  .map(function(obj){
    obj.shortName = obj.id.split('/').slice(-1)[0];
    return obj;
  });

var qcn_produtos = qcn_assets.filter(function(obj){ return obj.shortName.split('_')[0] === 'produtos';});

// qcn_produtos = qcn_produtos.filter(function(obj){ return obj.shortName.split('_').slice(-1)[0] === 'cerrado';});
print('qcn_produtos',qcn_produtos);
var recipe_1994 = ee.Image().rename('produtos_1994');
var recipe_2002 = ee.Image().rename('produtos_2002');
var recipe_2010 = ee.Image().rename('produtos_2010');
var recipe_2016 = ee.Image().rename('produtos_2016');

qcn_produtos.forEach(function(obj){
  var fc = ee.FeatureCollection(obj.id)
    .map(function(ft){
      return ft
        .set('classId_1994',ee.Dictionary(dictionary).getNumber(ft.get('cagr_1994')).int())
        .set('classId_2002',ee.Dictionary(dictionary).getNumber(ft.get('cagr_2002')).int())
        .set('classId_2010',ee.Dictionary(dictionary).getNumber(ft.get('cagr_2010')).int())
        .set('classId_2016',ee.Dictionary(dictionary).getNumber(ft.get('cagr_2016')).int());
    });
  recipe_1994 = recipe_1994.blend(ee.Image().paint(fc,'classId_1994'));
  recipe_2002 = recipe_2002.blend(ee.Image().paint(fc,'classId_2002'));
  recipe_2010 = recipe_2010.blend(ee.Image().paint(fc,'classId_2010'));
  recipe_2016 = recipe_2016.blend(ee.Image().paint(fc,'classId_2016'));
  
  print(obj.shortName,obj,'fc',fc.limit(10));
  
  
});

var produtos = ee.Image().select()
  .addBands(recipe_1994)
  .addBands(recipe_2002)
  .addBands(recipe_2010)
  .addBands(recipe_2016);
  
print('produtos',produtos);

Map.addLayer(produtos.select(0).randomVisualizer(),{},'produtos');

var description = 'qcn-produtos_cagr-raster_stack';
var assetId = 'projects/mapbiomas-workspace/CCAL/DATASETS/QCN/dados_tratados/' + description;

Export.image.toAsset({
  image:produtos,
  description:description,
  assetId:assetId,
  pyramidingPolicy:'mode',
  // dimensions, 
