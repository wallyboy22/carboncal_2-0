// 🔹 Função para calcular mudanças temporais para substituir as classes de outras transições
function defining_other_transitions() {
  var container = ee.Image().select();
  
  var bandnames = [
  'classification_1985', // para selecionar o ano de 1985 na comparação com 1986
  'classification_1986','classification_1987','classification_1988','classification_1989','classification_1990',
  'classification_1991','classification_1992','classification_1993','classification_1994','classification_1995',
  'classification_1996','classification_1997','classification_1998','classification_1999','classification_2000',
  'classification_2001','classification_2002','classification_2003','classification_2004','classification_2005',
  'classification_2006','classification_2007','classification_2008','classification_2009','classification_2010',
  'classification_2011','classification_2012','classification_2013','classification_2014','classification_2015',
  'classification_2016','classification_2017','classification_2018','classification_2019','classification_2020',
  'classification_2021','classification_2022','classification_2023','classification_2024'
  ];

  
  bandnames.slice(1,-1).forEach(function(bandname) {
    var index = bandnames.indexOf(bandname);
    var prev_bands = bandnames.slice(0, index);
    var post_bands = bandnames.slice(index + 1);

    var sec_veg = deforestationSecondaryVeg.select(bandname);
    var sec_veg_7 = sec_veg.eq(7);
    var img_bandname = simple_lulc.select(bandname);

    var img_prev_bands = simple_lulc.select(prev_bands).updateMask(sec_veg_7.neq(0)).reduce('first');
    var img_post_bands = simple_lulc.select(post_bands).updateMask(sec_veg_7.neq(0)).reduce('first');

    var sum = img_prev_bands.unmask().multiply(10).add(img_post_bands.unmask()).selfMask();

    // 🔹 Mapeamento de pixels (remapeando valores)
    var remap_0 = [0, 1, 2, 10, 11, 12, 20, 21, 22];
    var remap_1 = [0, 1, 2, 1, 1, 3, 2, 1, 2];
    var remap = sum.remap(remap_0, remap_1);

    var final_image = sec_veg.where(sec_veg.eq(7), remap);
    container = container.addBands(final_image);
  });

  return container;
}

