///////////// Regime do Fogo ////////////////////
var importarDados = function() {
    var fogo_ac = ee.Image('projects/ee-ipam/assets/CCAL/DATASETS/MAPBIOMAS/mapbiomas_fire_collection31_fire_recurrence_v2_prodes_year')
        .multiply(prodes_forest)
        .multiply(brazil_forests)
        .int();
    fogo_ac = fogo_ac.select(fogo_ac.bandNames().remove('fire_recurrence_1986_1986_1'));

    var ysf = ee.Image('projects/ee-ipam/assets/CCAL/DATASETS/MAPBIOMAS/mapbiomas_fire_collection31_time_after_fire_v2_prodes_year')
        .slice(0,-1)
        .selfMask()
        .multiply(prodes_forest)
        .multiply(brazil_forests);
    

    return {
        //fogo: fogo.clip(aoi),
        fogo_ac: fogo_ac.clip(aoi),
        ysf: ysf.clip(aoi),
    };
};

// Reclassificação da Frequência de Fogo
var reclassificarFrequenciaFogo = function(fogo_ac_sav) {
    var fogo_ac_mean = fogo_ac_sav.reduce("mean");
    
    return fogo_ac_mean
        .where(fogo_ac_mean.gte(1).and(fogo_ac_mean.lt(3)), 1) // baixa severidade
        .where(fogo_ac_mean.gte(3).and(fogo_ac_mean.lt(5)), 2) // media-baixa
        .where(fogo_ac_mean.gte(5).and(fogo_ac_mean.lt(7)), 3) // media-alta
        .where(fogo_ac_mean.gte(7), 4); // alta
  
};

// Fator de perdas espacializados com base no regime do fogo
var calcularMudanca = function(fogo_sev) {
    var agb_loss = fogo_sev
        .where(fogo_sev.gte(2).and(fogo_sev.lte(3)), 0.021) // 
        .where(fogo_sev.gt(3).and(fogo_sev.lte(6)), -0.004)
        .where(fogo_sev.gt(6), -0.02);

    return agb_loss;
    
};


// Código Principal
var main = function() {
    var dados = importarDados();
    var fogo_ac = dados.fogo_ac;
    var fogo_ac_reclassificado = reclassificarFrequenciaFogo(fogo_ac);
    
    var ysf_reclassificado = dados.ysf
        .where(dados.ysf.gte(0).and(dados.ysf.lt(4)), 4) // baixo tempo de recuperacao
        .where(dados.ysf.gte(4).and(dados.ysf.lt(7)), 3) // medio-baixo tempo
        .where(dados.ysf.gte(7).and(dados.ysf.lt(10)), 2) // medio-alto tempo
        .where(dados.ysf.gte(10), 1); // alto tempo
    
    var fogo_sev = ysf_reclassificado.add(fogo_ac_reclassificado);
    
    var factors = calcularMudanca(fogo_sev);

    return factors
};

