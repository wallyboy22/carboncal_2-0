/**
 * Estatísticas de Área por Classe Textural e Cobertura do Solo
 * 
 * Este script calcula estatísticas de área para classes texturais do solo combinadas com classes de cobertura do solo,
 * agrupadas por bioma e unidade federativa no Brasil. Os resultados são exportados como um arquivo CSV.
 * 
 * Autor: Wallace Vieira e David Pontes
 * Data: 27/11/2024
 * 
 * Descrição:
 * - Carrega dados de textura do solo (frações de areia, silte e argila) para a camada de 0-30 cm.
 * - Classifica a textura do solo com base nas frações em classes predefinidas.
 * - Carrega dados de uso e cobertura do solo da Coleção 9 do MapBiomas.
 * - Remapeia as classes de cobertura do solo em níveis principais, excluindo corpos d'água.
 * - Combina textura do solo e cobertura do solo em uma única imagem.
 * - Calcula estatísticas de área agrupadas por classe textural, classe de cobertura, bioma e unidade federativa.
 * - Exporta os resultados para o Google Drive como um arquivo CSV.
 * 
 * Nota: Este script utiliza a API JavaScript do Google Earth Engine.
 */

// --- opções
var scale = 500;
var version = '2025_03_10-1-v033';
var description = 'area_CIAT_project_and_carbonstock_per_landcover_';
var folder = 'CCAL_CIAT';

// --- Datasets
// Limites dos biomas
var biomas = ee.FeatureCollection("projects/mapbiomas-workspace/AUXILIAR/biomas_IBGE_250mil");


// Limites das unidades federativas (estados)
var estados = ee.FeatureCollection('projects/mapbiomas-workspace/AUXILIAR/estados-2017')
  .map(function(feature){
    return feature.set({
      CD_GEOCUF: ee.Number.parse(feature.get('CD_GEOCUF')),
    });
  });

// Carregando a camada de uso e cobertura do solo (Coleção 9)
var landCover_original = ee.Image('projects/mapbiomas-public/assets/brazil/lulc/collection9/mapbiomas_collection90_integration_v1');

// Visualização da cobertura do solo remapeada
Map.addLayer(landCover_original, {
    'bands': 'classification_2023',
    'palette': require('users/mapbiomas/modules:Palettes.js').get('classification8'),
    'min': 0,
    'max': 69
}, 'Uso e Cobertura do Solo 2023', false);



// Nova coleção de carbono na biomassa
// var biomass_stock_carbon = ee.Image('projects/ee-ipam/assets/SEEG/CIAT/biomass_stock_tC_ha-CIAT-QCN_MapBiomas9-1986_2023-v032');
var biomass_stock_carbon_degradation = ee.Image('projects/ee-ipam/assets/SEEG/CIAT/biomass_stock_carbon_degradation_t_ha-CIAT-QCN_MapBiomas9-1986_2023-v033');
var co2e_deforestation = ee.Image('projects/ee-ipam/assets/SEEG/CIAT/co2e_deforestation_t_ha-CIAT-QCN_MapBiomas9-1986_2023-v033');
var co2e_fire = ee.Image('projects/ee-ipam/assets/SEEG/CIAT/co2e_fire_t_ha-CIAT-QCN_MapBiomas9-1986_2023-v033');
var co2e_liquid = ee.Image('projects/ee-ipam/assets/SEEG/CIAT/co2e_liquid_t_ha-CIAT-QCN_MapBiomas9-1986_2023-v033');
var co2e_logging = ee.Image('projects/ee-ipam/assets/SEEG/CIAT/co2e_logging_t_ha-CIAT-QCN_MapBiomas9-1986_2023-v033');
var co2e_removal = ee.Image('projects/ee-ipam/assets/SEEG/CIAT/co2e_removal_t_ha-CIAT-QCN_MapBiomas9-1986_2023-v033');
var biomass_stock_projection = ee.Image('projects/ee-ipam/assets/SEEG/CIAT/biomass_stock_carbon_projection_t_ha-CIAT-QCN_MapBiomas9-2024_2050-v033');

var table_legal_amazon = ee.FeatureCollection('projects/mapbiomas-territories/assets/TERRITORIES/LULC/BRAZIL/COLLECTION9/WORKSPACE/LEGAL_AMAZON');
var image_legal_amazon = ee.Image().paint(table_legal_amazon).eq(0);

var aoi_ciat = ee.FeatureCollection('projects/ee-ipam/assets/SEEG/CIAT/CIAT_geral_PPA_carbon')

var aoi_ciat_ids = aoi_ciat.aggregate_array('Project').distinct();

aoi_ciat = aoi_ciat.map(function(f){
  var id = aoi_ciat_ids.indexOf(f.getString('Project')).add(1);
  
  var Project_legend = ee.String(id).cat(':').cat(f.getString('Project'))
  
  return f.set({
    Project_id:id,
    Project_legend:Project_legend,
  });
});

var aoi_ciat_legend = aoi_ciat.aggregate_array('Project_legend').distinct();



print('aoi_ciat',aoi_ciat,aoi_ciat.aggregate_array('Project').distinct(),aoi_ciat.aggregate_array('Project_id').distinct(),aoi_ciat.aggregate_array('Project_legend').distinct());

var aoi_id_image = ee.Image().paint(aoi_ciat,'Project_id');



Map.addLayer(aoi_id_image,{min:0,max:14},'aoi_id_image');
Map.addLayer(table_legal_amazon.geometry().bounds(),{},'bounds');
// Limites geométricos dos biomas para o calculo de área, comentar para testes em uma area reduzida
// var bounds = table_legal_amazon.geometry().bounds();
var bounds = geom2;


var stack_observad = biomass_stock_carbon_degradation.slice(1)
    .addBands(co2e_deforestation)
    .addBands(co2e_fire)
    .addBands(co2e_liquid)
    .addBands(co2e_logging)
    .addBands(co2e_removal)
    .addBands(biomass_stock_projection)
    .multiply(aoi_id_image.gt(0));

Map.addLayer(stack_observad,{},'stack_observad');

print('bandnames',stack_observad.bandNames(),stack_observad.bandNames().map(function(s){return ee.String(s).slice(0,-5);}).distinct());


// Cálculo da área em hectares
var pixelAreaHa = ee.Image.pixelArea().divide(1e4).multiply(aoi_id_image.gt(0)); // Converter m² para hectares
var pixelTonelada = stack_observad.multiply(pixelAreaHa); // Converter toneladas por hectare para hectare

// Imagens dos biomas e estados para mapeamento territorial
var biomas_img = ee.Image().paint(biomas, 'CD_Bioma');
var estados_img = ee.Image().paint(estados, 'CD_GEOCUF');
var territory_img = estados_img.multiply(10).add(biomas_img).multiply(100).add(aoi_id_image);

Map.addLayer(territory_img.randomVisualizer(),{},'territory_img');

var biomasClasses = ee.Dictionary({
  0:'Não observado',
  1:'Amazônia',
  2:'Caatinga',
  3:'Cerrado',
  4:'Mata Atlântica',
  5:'Pampa',
  6:'Pantanal',
});

var unidadeFederativaClasses = ee.Dictionary({
  0: 'Não observado',
  11: 'Rondônia',
  12: 'Acre',
