// util: index = "classe-territory-ano"
function makeIndex(classe_int, territory_int, year) {
  return ee.String(classe_int).cat('-').cat(territory_int).cat('-').cat(year);
}

/*************** 1) TABELA-BASE: ÁREA (todas as linhas) ***************/
var years = landCover_original.bandNames()
  .map(function(b){ return ee.String(b).slice(-4); })
  .distinct().sort();

var table_area_all = ee.FeatureCollection(years.map(function(year){
  year = ee.String(year);

  var observed_area = ee.Image.pixelArea().divide(1e4)
    .addBands(landCover_original.select(ee.String('classification_').cat(year)))
    .addBands(territory_img);

  var groups = observed_area.reduceRegion({
    reducer: ee.Reducer.sum().group(1,'territory').group(1,'classe'),
    geometry: bounds,
    scale: scale,
    maxPixels: 1e13
  }).get('groups');

  var fc = ee.FeatureCollection(ee.List(groups).map(function(g1){
    g1 = ee.Dictionary(g1);
    var classe_int = g1.getNumber('classe').int();

    return ee.FeatureCollection(ee.List(g1.get('groups')).map(function(g2){
      g2 = ee.Dictionary(g2);
      var territory_int = g2.getNumber('territory').int();
      var area_ha = g2.getNumber('sum');

      return ee.Feature(null).set({
        'index': makeIndex(classe_int, territory_int, year),
        'Ano': year,
        'Área ha': area_ha,
        'Cobertura n0': nivel_0.get(classe_int),
        'Cobertura n1': nivel_1.get(classe_int),
        'Cobertura n1_1': nivel_1_1.get(classe_int),
        'Cobertura n2': nivel_2.get(classe_int),
        'Cobertura n3': nivel_3.get(classe_int),
        'Cobertura n4': nivel_4.get(classe_int),
        'Bioma': biomasClasses.get(territory_int.mod(10).int()),
        'Unidade Federativa': unidadeFederativaClasses.get(territory_int.divide(10).int()),
        'UF': ufClasses.get(territory_int.divide(10).int())
      });
    }));
  })).flatten();

  return fc;
})).flatten();

// começa a “tabela final” com a área
var tableFinal = ee.FeatureCollection(table_area_all);

/*************** 2) LOOP POR MÉTRICA: reduzir e juntar ***************/
metrics.forEach(function(metric){

  // todas as bandas disponíveis dessa métrica (pode faltar ano)
  var metricBands = pixelTonelada.select(ee.String(metric).cat('.*')).bandNames();

  // coleção com index + tons_<métrica> por (classe,territory,ano) onde a banda existir
  var table_metric = ee.FeatureCollection(metricBands.map(function(bandname){
    bandname = ee.String(bandname);
    var year = bandname.slice(-4);

    var observed = pixelTonelada.select([bandname])
      .addBands(landCover_original.select(ee.String('classification_').cat(year)))
      .addBands(territory_img);

    var groups = observed.reduceRegion({
      reducer: ee.Reducer.sum().group(1,'territory').group(1,'classe'),
      geometry: bounds,
      scale: scale,
      maxPixels: 1e13
    }).get('groups');

    var fc = ee.FeatureCollection(ee.List(groups).map(function(g1){
      g1 = ee.Dictionary(g1);
      var classe_int = g1.getNumber('classe').int();

      return ee.FeatureCollection(ee.List(g1.get('groups')).map(function(g2){
        g2 = ee.Dictionary(g2);
        var territory_int = g2.getNumber('territory').int();
        var toneladas = g2.getNumber('sum');

        // define a coluna específica desta métrica
        var tons_col = ee.String('tons_').cat(metric);

        return ee.Feature(null).set({
          'index': makeIndex(classe_int, territory_int, year)
        }).set(tons_col, toneladas);
      }));
    })).flatten();

    return fc;
  })).flatten();

  // LEFT OUTER join: mantém tudo da área, agrega a coluna tons_<métrica> quando existir
  var join = ee.Join.saveFirst({matchKey: 'secondary'});
  var filter_join = ee.Filter.equals({leftField: 'index', rightField: 'index'});
  var joined = join.apply(tableFinal, table_metric, filter_join);

  tableFinal = ee.FeatureCollection(joined).map(function (f) {
    f = ee.Feature(f);                         // já tem as props da área
    var out = ee.Feature(null).copyProperties(f);
    var secondary = ee.Feature(f.get('secondary')); // pode ser null
    return ee.Algorithms.If(secondary, out.copyProperties(secondary), out);
  });
});

