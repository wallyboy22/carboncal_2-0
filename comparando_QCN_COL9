// Função para remapear mapas de uso e cobertura
function convertToNewValues(img_lulc, oldValues, newValues) {
  var new_img = img_lulc.multiply(0);
  oldValues.forEach(function(classe, i) {
    new_img = new_img.where(img_lulc.eq(classe), newValues[i]);
  });
  return new_img;
}

// --- Lidando com a classe de "Não Observado" ---
function handleUnobserved(img_lulc,class_un_observed) {
  return ee.Image(
    img_lulc.bandNames().iterate(function(current, previous) {
      var bandName = ee.String(current);
      var img_year = img_lulc.select(bandName);
      var position = img_lulc.bandNames().indexOf(bandName);
      var img_prevYear = ee.Image().addBands(img_lulc).select(position);
      img_year = img_year.where(img_year.eq(class_un_observed), img_prevYear);
      return ee.Image(previous).addBands(img_year);
    }, ee.Image().select())
  );
}

