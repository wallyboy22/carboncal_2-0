// // (Opcional) Cria uma imagem para desenhar os limites dos biomas, se necessário
// var biomes_line = ee.Image().paint(biomes, 1, 1);

// Itera sobre cada camada adicionada ao mapa para extrair e exibir informações organizadas.
// Essa rotina gera, para cada camada (exceto a de fundo branco), um painel contendo:
//   - O nome da camada com destaque.
//   - Os parâmetros de visualização (visParams) em formato JSON.
//   - Uma miniatura (thumbnail) da camada para inspeção visual.
//   - Um link informativo para tutorial de raster virtual no QGIS.
//   - A URL do MapId, que pode ser utilizada para integrar a camada em outras plataformas.

Map.layers().forEach(function(layer) {
  // Ignora a camada de fundo branco
  if (layer.getName() === 'White Background') {
    return;
  }

  // Recupera o objeto Earth Engine (eeObject) e os parâmetros de visualização da camada
  var eeObject = layer.getEeObject();
  var visParams = layer.getVisParams();
  var layerName = layer.getName();
  
  var biomes_line = ee.Image().paint(biomes,1,1);

  
  // Cria uma miniatura para a camada, utilizando o método ui.Thumbnail.
  // A miniatura é gerada a partir da visualização da camada, possivelmente combinada com a linha dos biomas.
  var thumbnail = ui.Thumbnail({
    image: eeObject.visualize(visParams).blend(biomes_line),
    params: {
      dimensions: 512,                    // Define as dimensões da miniatura
      region: biomes.geometry().bounds()  // Define a região de interesse com base no shapefile dos biomas
    },
    style: {
      margin: '10px 0',
      border: '1px solid #ccc'
    }
  });

  // Cria um painel para organizar as informações da camada
  var layerPanel = ui.Panel({
    widgets: [
      // Rótulo com o nome da camada, estilizado para destaque
      ui.Label({
        value: 'Camada: ' + layerName,
        style: {
          fontSize: '16px',
          fontWeight: 'bold',
          color: '#333',
          margin: '0 0 10px 0'
        }
      }),
      // Exibe os parâmetros de visualização em formato JSON, para inspeção técnica
      ui.Label({
        value: 'Visual Params: ' + JSON.stringify(visParams, null, 2),
        style: {
          fontSize: '12px',
          color: '#555',
          margin: '5px 0'
        }
      }),
      // Insere a miniatura da camada
      thumbnail,
      // Rótulo com link para tutorial sobre raster virtual no QGIS
      ui.Label({
        value: '⚠️ Raster Virtual. Clique para aprender como adicionar mapas no QGIS',
        targetUrl: 'https://brasil.mapbiomas.org/wp-content/uploads/sites/4/2024/06/Adicionar-raster-virtual-no-qgis.pdf',
        style: {
          fontSize: '12px',
          color: '#007bff',
          margin: '5px 0',
          textDecoration: 'underline'
        }
      }),
      // Exibe a URL do MapId para integração externa
      ui.Label({
        value: 'URL do MapId: ' + eeObject.visualize(visParams).getMapId().urlFormat,
        style: {
          fontSize: '12px',
          color: '#555',
          margin: '5px 0'
        }
      })
    ],
    style: {
      border: '1px solid #ddd',
      backgroundColor: '#f9f9f9',
      padding: '10px',
      margin: '10px 0'
    }
  });

  // Adiciona o painel à interface principal (pode ser descomentado para inclusão no UI)
