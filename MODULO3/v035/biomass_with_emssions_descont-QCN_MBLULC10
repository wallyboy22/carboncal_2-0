function plotCharts(str, metrics_list, metric_bands_pixelTonelada) {
  // util: index = "classe-territory-ano"
  function makeIndex(classe_int, territory_int, year) {
    return ee.String(classe_int).cat('-').cat(territory_int).cat('-').cat(year);
  }

  /*************** 1) TABELA-BASE: ÁREA (todas as linhas) ***************/
  var years = landCover_original.bandNames()
    .map(function (b) { return ee.String(b).slice(-4); })
    .distinct().sort();

  var table_area_all = ee.FeatureCollection(years.map(function (year) {
    year = ee.String(year);

    var observed_area = ee.Image.pixelArea().divide(1e4)
      .addBands(landCover_original.select(ee.String('classification_').cat(year)))
      .addBands(territory_img);

    var groups = observed_area.reduceRegion({
      reducer: ee.Reducer.sum().group(1, 'territory').group(1, 'classe'),
      geometry: bounds,
      scale: scale,
      maxPixels: 1e13
    }).get('groups');

    var fc = ee.FeatureCollection(ee.List(groups).map(function (g1) {
      g1 = ee.Dictionary(g1);
      var classe_int = g1.getNumber('classe').int();

      return ee.FeatureCollection(ee.List(g1.get('groups')).map(function (g2) { // <-- sintaxe OK
        g2 = ee.Dictionary(g2);
        var territory_int = g2.getNumber('territory').int();
        var area_ha = g2.getNumber('sum');

        return ee.Feature(null).set({
          'index': makeIndex(classe_int, territory_int, year),
          'Ano': year,
          'Área ha': area_ha,
          'Cobertura n0': nivel_0.get(classe_int),
          'Cobertura n1': nivel_1.get(classe_int),
          'Cobertura n1_1': nivel_1_1.get(classe_int),
          'Cobertura n2': nivel_2.get(classe_int),
          'Cobertura n3': nivel_3.get(classe_int),
          'Cobertura n4': nivel_4.get(classe_int),
          'Bioma': biomasClasses.get(territory_int.mod(10).int()),
          'Unidade Federativa': unidadeFederativaClasses.get(territory_int.divide(10).int()),
          'UF': ufClasses.get(territory_int.divide(10).int())
        });
      }));
    })).flatten();

    return fc;
  })).flatten();

  // começa a “tabela final” com a área
  var tableFinal = ee.FeatureCollection(table_area_all);

  var ui_panel = ui.Panel({ style: { 'width': '500px' } });
  ui.root.add(ui_panel);

  /*************** 2) LOOP POR MÉTRICA: reduzir e juntar ***************/
  metrics_list.forEach(function (metric) {
    // usa SEMPRE o parâmetro metric_bands_pixelTonelada
    var metricBands = metric_bands_pixelTonelada
      .select(ee.String(metric).cat('.*'))
      .bandNames();

    // coleção com index + tons_<métrica>
    var table_metric = ee.FeatureCollection(metricBands.map(function (bandname) {
      bandname = ee.String(bandname);
      var year = bandname.slice(-4);

      var observed = metric_bands_pixelTonelada.select([bandname])
        .addBands(landCover_original.select(ee.String('classification_').cat(year)))
        .addBands(territory_img);

      var groups = observed.reduceRegion({
        reducer: ee.Reducer.sum().group(1, 'territory').group(1, 'classe'),
        geometry: bounds,
        scale: scale,
        maxPixels: 1e13
      }).get('groups');

      var fc = ee.FeatureCollection(ee.List(groups).map(function (g1) {
        g1 = ee.Dictionary(g1);
        var classe_int = g1.getNumber('classe').int();

        return ee.FeatureCollection(ee.List(g1.get('groups')).map(function (g2) {
          g2 = ee.Dictionary(g2);
          var territory_int = g2.getNumber('territory').int();
          var toneladas = g2.getNumber('sum');

          var tons_col = ee.String('tons_').cat(metric); // mantém seu padrão

          return ee.Feature(null).set({
            'index': makeIndex(classe_int, territory_int, year)
          }).set(tons_col, toneladas);
        }));
      })).flatten();

      return fc;
    })).flatten();

    // join externo esquerdo
    var join = ee.Join.saveFirst({ matchKey: 'secondary' });
    var filter_join = ee.Filter.equals({ leftField: 'index', rightField: 'index' });
    var joined = join.apply(tableFinal, table_metric, filter_join);

    tableFinal = ee.FeatureCollection(joined).map(function (f) {
      f = ee.Feature(f);
      var out = ee.Feature(null).copyProperties(f);
      var secondary = ee.Feature(f.get('secondary')); // pode ser null
      return ee.Algorithms.If(secondary, out.copyProperties(secondary), out);
    });
  });

  /*************** 3) EXPORT + SEUS GRÁFICOS (por polígono) ***************/
  var props = ee.Feature(tableFinal.first()).propertyNames();
  var tonsColsPresent = ee.List(props).filter(ee.Filter.stringStartsWith('item', 'tons_'));

  print(ui.Label('Prévia')); print(tableFinal);
  print(ui.Label('Colunas tons_* presentes')); print(tonsColsPresent);

  ee.List([
    'Ano',
    'Cobertura n0',
    'Cobertura n1_1',
    'Cobertura n2',
    'Cobertura n3',
    'Cobertura n4',
    'Bioma',
    'UF',
    'Unidade Federativa',
    'Área ha'
  ]).cat(tonsColsPresent).evaluate(function (selectors) {

    print(ui.Label('Colunas exportadas')); print(ui.Label(selectors));

    Export.table.toDrive({
      collection: tableFinal,
      description: 'WSIPAM_metricas_wide_join_' + version,
      fileNamePrefix: description + '_metricas_wide_join_' + version,
      fileFormat: 'CSV',
      folder: folder,
      selectors: selectors
    });

    /*************** AGREGAR POR ANO: totais e t/ha ***************/
    var years = ee.List(tableFinal.aggregate_array('Ano')).distinct().sort();

    var yearly = ee.FeatureCollection(years.map(function (y) {
      y = ee.String(y);
      var fcY = tableFinal.filter(ee.Filter.eq('Ano', y));

      var base = ee.Dictionary({
        'Ano': y,
        'Área ha': ee.Number(ee.Algorithms.If(fcY.size().gt(0), fcY.aggregate_sum('Área ha'), 0))
      });

      var tonsList = ee.List(ee.Feature(tableFinal.first()).propertyNames())
        .filter(ee.Filter.stringStartsWith('item', 'tons_'));

      var dict = ee.List(tonsList).iterate(function (col, acc) {
        col = ee.String(col);
        acc = ee.Dictionary(acc);
        var sumCol = ee.Number(ee.Algorithms.If(fcY.size().gt(0), fcY.aggregate_sum(col), 0));
        return acc.set(col, sumCol);
      }, base);

      return ee.Feature(null, ee.Dictionary(dict));
    }));

    var yearlyWithTPH = yearly.map(function (f) {
      var area = ee.Number(f.get('Área ha'));
      var tonsProps = f.propertyNames().filter(ee.Filter.stringStartsWith('item', 'tons_'));
      var updated = ee.List(tonsProps).iterate(function (p, acc) {
        p = ee.String(p);
        acc = ee.Feature(acc);
        var tphName = ee.String('tons_por_ha_').cat(p.slice(5)); // remove 'tons_'
        var tphVal = ee.Algorithms.If(area.gt(0), ee.Number(acc.get(p)).divide(area), null);
        return acc.set(tphName, tphVal);
      }, f);
      return ee.Feature(updated);
    });

    // helpers de gráfico (os mesmos que você já usava)
    function chartComboForMetric(fc, tonsCol, title) {
      var tphCol = 'tons_por_ha_' + tonsCol.slice(5);
      var chart = ui.Chart.feature.byFeature({
        features: fc,
        xProperty: 'Ano',
        yProperties: [tonsCol, tphCol]
      })
        .setChartType('ComboChart')
        .setOptions({
          title: title,
          hAxis: { title: 'Ano' },
          vAxes: {
            0: { title: 'Toneladas (total)' },
            1: { title: 'Toneladas por ha' }
          },
          seriesType: 'bars',
          series: {
            0: { targetAxisIndex: 0, type: 'bars' },
            1: { targetAxisIndex: 1, type: 'line' }
          },
          bar: { groupWidth: '70%' },
          pointSize: 4,
          legend: { position: 'bottom' }
        });
      ui_panel.add(chart);
    }

    function makeSeriesConfig(names, rightName) {
      var cfg = {};
      names.forEach(function (name, idx) {
        cfg[idx] = (name === rightName) ? { targetAxisIndex: 1 } : { targetAxisIndex: 0 };
      });
      return cfg;
